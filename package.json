{
  "name": "fairy-ring",
  "version": "0.2.0",
  "description": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loganzartman/fairy-ring.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/standalone.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./standalone": "./dist/standalone.js",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "storybook dev -p 6006",
    "pr-check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "build-storybook": "storybook build",
    "test": "./scripts/test.sh",
    "test:update": "./scripts/test.sh --update"
  },
  "dependencies": {
    "@lit/task": "^1.0.3",
    "lit": "^3.3.3",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "highlight.js": "^11.12.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "solid-js": "^2.0.1",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "solid-js": "^2.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "packageManager": "pnpm@9.13.2"
}
